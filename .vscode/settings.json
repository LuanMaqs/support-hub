{
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.sfdx": true,
    "**/.sf": true
  },
  "files.exclude": {
    "**/.sfdx": true,
    "**/.sf": true
  },
  "editor.formatOnSave": true,
  "[apex]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[xml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "salesforcedx-vscode-core.show-cli-success-msg": false
}
